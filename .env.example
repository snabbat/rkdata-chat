# =============================================================================
# RK Data — Chat avec votre Lakehouse : configuration de la démo
# Copier ce fichier en `.env` (jamais versionné) puis lancer `docker compose up -d --build`.
#
# Les mots de passe ci-dessous sont des valeurs de DÉMONSTRATION : à changer
# avant tout déploiement chez un client (coffre-fort / gestionnaire de secrets).
# =============================================================================

# --- Versions des images ----------------------------------------------------
# MinIO ne publie plus d'images officielles sur Docker Hub : on utilise les
# builds maintenus par Chainguard (ou toute image MinIO de votre registre interne).
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MC_IMAGE=cgr.dev/chainguard/minio-client:latest-dev
POSTGRES_VERSION=16
HIVE_VERSION=4.0.1
TRINO_VERSION=484
OLLAMA_VERSION=0.40.17
PYTHON_VERSION=3.12-slim

# --- Secrets de démonstration -----------------------------------------------
MINIO_ROOT_USER=rkdata
MINIO_ROOT_PASSWORD=demo-minio-2026
HMS_DB_USER=hive
HMS_DB_PASSWORD=demo-metastore-2026

# --- LLM (on-premise) ---------------------------------------------------------
# LLM_PROVIDER : ollama | openai (tout serveur compatible OpenAI : vLLM, LM Studio...)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=
LLM_NUM_CTX=8192
# Durée pendant laquelle Ollama garde le modèle en mémoire après une question.
LLM_KEEP_ALIVE=60m

# Choix du serveur Ollama :
#   A) Ollama en conteneur (par défaut) :
#        COMPOSE_PROFILES=ollama
#        LLM_BASE_URL=http://ollama:11434
#   B) Ollama déjà installé sur le poste (Windows / macOS) — le conteneur n'est pas démarré :
#        COMPOSE_PROFILES=
#        LLM_BASE_URL=http://host.docker.internal:11434
#      (penser à : ollama pull qwen2.5-coder:7b)
COMPOSE_PROFILES=ollama
LLM_BASE_URL=http://ollama:11434

# GPU NVIDIA pour l'Ollama en conteneur : décommenter les deux lignes suivantes.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml

# --- Garde-fous -------------------------------------------------------------
MAX_ROWS=200
QUERY_TIMEOUT_S=30

# --- Ports publiés sur le poste ---------------------------------------------
APP_PORT=8501
TRINO_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Divers -------------------------------------------------------------------
# Utilisateur inscrit dans le journal d'audit (à défaut d'en-tête X-Forwarded-User).
APP_USER=demo
# Mettre à 1 pour forcer le rechargement des données au prochain `docker compose up`.
FORCE_SEED=0
